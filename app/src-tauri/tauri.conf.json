{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDisk",
  "version": "0.3.0",
  "identifier": "io.github.opendisk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenDisk",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Find what fills your disk and free space safely",
    "longDescription": "OpenDisk scans your home folder, shows a disk map that includes hidden folders and explains every cache it finds (developer tools, AI models, browsers, apps). It cleans only what you pick, after a preview, and moves most things to the Trash so they can be put back.",
    "copyright": "Copyright (c) 2026 Raúl López. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "publisher": "Raúl López",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "upgradeCode": "73515EEC-C92C-4599-9F09-5B2F51459141",
        "language": "en-US"
      }
    }
  }
}
